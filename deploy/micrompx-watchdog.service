[Unit]
Description=Local observe-only MicroMPX watchdog
After=network-online.target micrompx.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/micrompx-watchdog -config /etc/micrompx-watchdog/config.json
# Never restarts/resets the decoder. Only watchdog failures are restarted.
# After the start limit is hit it stays stopped; an optional heartbeat expires.
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
User=micrompx-watchdog
Group=micrompx-watchdog
SupplementaryGroups=systemd-journal
StateDirectory=micrompx-watchdog
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
